{
  "name": "voicebox-cli-agent-skill",
  "version": "0.1.0",
  "description": "Open Agent Skill and CLI-Anything harness for operating Voicebox from agent workflows.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "voicebox-cli-agent-skill": "scripts/voicebox-cli-agent.js",
    "voicebox-cli-agent": "scripts/voicebox-cli-agent.js",
    "voicebox-cli-install-skill": "scripts/install-skill.js",
    "cli-anything-voicebox": "scripts/run-cli.js"
  },
  "files": [
    "README.md",
    "VOICEBOX.md",
    "TEST.md",
    "setup.py",
    "cli_anything/**/*.py",
    "skills/**/*.md",
    "skills/**/*.yaml",
    "scripts/install-skill.js",
    "scripts/run-cli.js",
    "scripts/voicebox-cli-agent.js"
  ],
  "scripts": {
    "setup": "node ./scripts/voicebox-cli-agent.js setup",
    "install-skill": "node ./scripts/install-skill.js",
    "test:cli": "python3 -m pytest cli_anything/voicebox/tests"
  },
  "keywords": [
    "voicebox",
    "agent-skill",
    "open-agent-skills",
    "cli-anything",
    "tts",
    "kokoro"
  ],
  "engines": {
    "node": ">=18"
  }
}
